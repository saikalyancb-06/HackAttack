# Groq (OpenAI-compatible). Several keys are rotated automatically when one hits its per-minute token limit.
GROQ_API_KEY1=
GROQ_API_KEY2=
GROQ_API_KEY3=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_ALT_MODEL=qwen/qwen3.8-27b
LLM_FAST_MODEL=openai/gpt-oss-20b
GUARD_MODEL=openai/gpt-oss-safeguard-20b
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# Optional: better web search than DuckDuckGo
TAVILY_API_KEY=
DATA_DIR=./data
# Writes touching these folders always need approval
PROTECTED_PATHS=C:\Windows;C:\Program Files;C:\Program Files (x86)
MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io
# 1 = show Excel/Word windows while the agent works (nice for demos)
OFFICE_VISIBLE=0
# Scale retry backoff (e.g. 0.2 for faster demos)
RETRY_BACKOFF_SCALE=1.0
